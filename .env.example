DATABASE_URL=apartment_hunter.db
LOG_LEVEL=INFO

# Geocoding (identify your app, free Nominatim usage policy)
GEOCODING_USER_AGENT=apartment-hunter/0.1.0 your@email.com

# Carte des loyers (ADR-0010): downloaded once per vintage, kept here
RENT_MAP_CACHE_DIR=.cache/carte-des-loyers

# Crawler tuning
RATE_LIMIT_SECONDS=1.5
MAX_CONCURRENT_CRAWLERS=5
REQUEST_TIMEOUT_SECONDS=30
